<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- ── PILL SEGMENT SELECTOR ── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/pillContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_container_bg"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/pillAllTime"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="All Time"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:background="@drawable/pill_selected_bg" />

                    <TextView
                        android:id="@+id/pillWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Week"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0D0D0D"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/pillMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Month"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/pillYear"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Year"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:background="@android:color/transparent" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── TOTALS SECTION ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Totals"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <!-- Totals 2-column grid row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/cardTotalBeers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍺 Total Beers"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTotalBeers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardTotalCost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💶 Total Spent"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTotalCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FBB122"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Totals row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 Volume"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTotalVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Satisfaction"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAverageSatisfaction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── DAILY AVERAGES ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Averages"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beers / Day"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvBeersPerDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cost / Day"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCostPerDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FBB122"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Volume per day full-width card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volume / Day"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvVolumePerDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- ── FAVORITES ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favorites"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠 Fav Bar"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvFavoriteBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍻 Fav Brand"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvFavoriteBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐 Fav Hour"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvFavoriteHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── MOST DRINKS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most Drinks"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠 Top Bar"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvMostBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍻 Top Brand"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvMostBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐 Top Hour"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvMostHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── STREAKS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streaks"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <!-- Drinking streak card with progress bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥 Longest Drinking Streak"
                        android:textSize="11sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvLongestDrinkingStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— days"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FBB122"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="#2A2A2A">

                    <View
                        android:id="@+id/progressDrinkingStreak"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="#FBB122"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Non-drinking streak card with progress bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💪 Longest Sober Streak"
                        android:textSize="11sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvLongestNonDrinkingStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— days"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF8B"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="#2A2A2A">

                    <View
                        android:id="@+id/progressSoberStreak"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="#4CAF8B"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ── COST BREAKDOWN ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cost Breakdown"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg / Beer"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAvgCostPerBeer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FBB122"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💸 Cheapest"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvCheapestBeer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF8B"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 Most Expensive"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvMostExpensiveBeer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- ── HEALTH METRICS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Metrics"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Est. Calories"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvEstimatedCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/stat_card_bg"
                    android:padding="14dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥃 Alcohol Units"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAlcoholUnits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── GLOBAL COMPARISON ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#FBB122"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Global Comparison"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <!-- Country comparison cards with progress bars -->
            <LinearLayout
                android:id="@+id/countryComparisonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <!-- Romania row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇷🇴 Romania" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvRomaniaRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barRomania" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- Georgia row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇬🇪 Georgia" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvGeorgiaRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barGeorgia" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- Latvia row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇱🇻 Latvia" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvLatviaRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barLatvia" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- France row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇫🇷 France" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvFranceRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barFrance" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- Ireland row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇮🇪 Ireland" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvIrelandRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barIreland" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- USA row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇺🇸 USA" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvUSARatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="10dp">
                    <View android:id="@+id/barUSA" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

                <!-- Bangladesh row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🇧🇩 Bangladesh" android:textSize="12sp" android:textColor="#AAAAAA"/>
                    <TextView android:id="@+id/tvBangladeshRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—x" android:textSize="12sp" android:textStyle="bold" android:textColor="#FBB122"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:background="#2A2A2A" android:layout_marginBottom="4dp">
                    <View android:id="@+id/barBangladesh" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FBB122"/>
                </FrameLayout>

            </LinearLayout>

            <!-- Closest country highlight card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/stat_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌍 You Drink Most Like…"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvClosestCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F4F4F4"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM BAR ── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="15dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAchievements"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:backgroundTint="#FBB122"
            app:cornerRadius="24dp"
            app:iconTint="@color/black"
            app:icon="@drawable/ic_trophy"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlcodex"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:backgroundTint="#FBB122"
            app:iconTint="@color/black"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_dashboard_black_24dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</FrameLayout>